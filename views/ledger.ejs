<%- include('partials/head', { title: 'Unreconciled ITC ledger' }) %>
<%- include('partials/header') %>
<%
  const byPeriod = ledger.pending.reduce((acc, e) => ({ ...acc, [e.period]: [...(acc[e.period] || []), e] }), {});
  const periods = Object.keys(byPeriod).sort().reverse();
  const total = ledger.pending.reduce((s, e) => s + e.tax, 0);
%>
<main class="max-w-7xl w-full mx-auto px-4 sm:px-6 py-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">Unreconciled ITC ledger</h1>
      <p class="mt-1 text-sm text-slate-600">Invoices in your books that were missing from GSTR-2B. Each new upload checks them against the new month's statement. JSON: <a class="underline" href="/api/ledger">/api/ledger</a></p>
    </div>
    <a href="/" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium hover:bg-slate-50">Back</a>
  </div>

  <p class="mt-5 text-sm text-slate-700"><strong><%= ledger.pending.length %></strong> pending invoice(s) &middot; ITC ₹<span class="num font-semibold text-red-700"><%= inr(total) %></span> still unclaimed &middot; <strong><%= ledger.claimed.length %></strong> claimed late</p>

  <% if (!periods.length) { %>
  <div class="mt-6 rounded-xl bg-white border border-slate-200 py-14 text-center text-slate-500">Nothing pending. Run a reconciliation to start building the ledger.</div>
  <% } %>

  <% periods.forEach(p => { const rows = byPeriod[p]; %>
  <section class="mt-6 rounded-xl bg-white border border-slate-200 overflow-hidden">
    <h2 class="px-4 py-3 bg-red-50 text-red-900 font-semibold text-sm"><%= periodLabel(p) %> <span class="font-normal">— <%= rows.length %> invoice(s), ₹<%= inr(rows.reduce((s, e) => s + e.tax, 0)) %></span></h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <tbody class="divide-y divide-slate-100">
          <% rows.forEach(e => { %>
          <tr>
            <td class="px-3 py-2"><%= e.name || '—' %></td>
            <td class="px-3 py-2 font-mono text-xs"><%= e.gstin %></td>
            <td class="px-3 py-2"><%= e.invoiceRaw %></td>
            <td class="px-3 py-2 whitespace-nowrap"><%= e.date || '—' %></td>
            <td class="px-3 py-2 text-right num"><%= inr(e.taxable) %></td>
            <td class="px-3 py-2 text-right num font-medium"><%= inr(e.tax) %></td>
            <td class="px-3 py-2 text-right"><button class="rm text-xs text-slate-500 underline hover:text-red-700" data-id="<%= e.id %>">Remove</button></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <% }) %>
</main>
<%- include('partials/footer') %>
<script>
  document.querySelectorAll('.rm').forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('Remove this invoice from the pending ledger?')) return;
    const res = await fetch('/api/ledger/' + encodeURIComponent(b.dataset.id), { method: 'DELETE' });
    if (res.ok) location.reload();
  }));
</script>
