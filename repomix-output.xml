const b2bWs = XLSX.utils.aoa_to_sheet(b2b);
b2bWs['!merges'] = [{ s: { r: 0, c: 2 }, e: { r: 0, c: 6 } }, { s: { r: 0, c: 10 }, e: { r: 0, c: 13 } }];
