  "name": "gstr-recon",
  "version": "1.0.0",
  "description": "GSTR-2B vs Purchase Register reconciliation tool for CAs and accountants",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
